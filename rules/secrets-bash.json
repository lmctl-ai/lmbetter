{
  "lang": "bash",
  "rules": [
    {
      "id": "SEC_AWS",
      "on": "string_content",
      "text_matches": "AKIA[0-9A-Z]{16}",
      "message": "AWS secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_AWS_RAW",
      "on": "raw_string",
      "text_matches": "AKIA[0-9A-Z]{16}",
      "message": "AWS secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_GITHUB",
      "on": "string_content",
      "text_matches": "ghp_[A-Za-z0-9]{36}([^A-Za-z0-9]|$)",
      "message": "GITHUB secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_GITHUB_FINE",
      "on": "string_content",
      "text_matches": "github_pat_[A-Za-z0-9_]{82}([^A-Za-z0-9_]|$)",
      "message": "GITHUB secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_GITHUB_RAW",
      "on": "raw_string",
      "text_matches": "ghp_[A-Za-z0-9]{36}([^A-Za-z0-9]|$)",
      "message": "GITHUB secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_GITHUB_FINE_RAW",
      "on": "raw_string",
      "text_matches": "github_pat_[A-Za-z0-9_]{82}([^A-Za-z0-9_]|$)",
      "message": "GITHUB secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_SLACK",
      "on": "string_content",
      "text_matches": "xox[baprs]-[0-9]+-[0-9]+-[A-Za-z0-9]{20,48}",
      "message": "SLACK secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_SLACK_RAW",
      "on": "raw_string",
      "text_matches": "xox[baprs]-[0-9]+-[0-9]+-[A-Za-z0-9]{20,48}",
      "message": "SLACK secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_PRIVATE_KEY",
      "on": "string_content",
      "text_matches": "-----BEGIN (RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----",
      "message": "PRIVATE_KEY secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_PRIVATE_KEY_RAW",
      "on": "raw_string",
      "text_matches": "-----BEGIN (RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----",
      "message": "PRIVATE_KEY secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_JWT",
      "on": "string_content",
      "text_matches": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{16,128}",
      "message": "JWT secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_JWT_RAW",
      "on": "raw_string",
      "text_matches": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{16,128}",
      "message": "JWT secret {text}",
      "severity": "critical",
      "redact": true
    },
    {
      "id": "SEC_ENTROPY",
      "query": "((variable_assignment name: (variable_name) @key value: [(string (string_content) @secret) (raw_string) @secret]) (#match? @key \"(^|[^A-Za-z0-9])([Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])$\") (#match? @secret \"^[\\\"']?[A-Za-z0-9+/=_-]{24,128}[\\\"']?$\") (#entropy-gt? @secret \"4.3\"))",
      "text_matches": "^[\"']?[A-Za-z0-9+/=_-]{24,128}[\"']?$",
      "message": "high-entropy credential {text}",
      "severity": "major",
      "redact": true,
      "capture": "secret"
    }
  ]
}
