{
  "lang": "bash",
  "rules": [
    {
      "id": "LBS001",
      "query": "((command name: (command_name (word) @w)) @cmd (#eq? @w \"rm\"))",
      "text_matches": "-([a-zA-Z]*r[a-zA-Z]*f|[a-zA-Z]*f[a-zA-Z]*r)",
      "message": "rm with recursive force flags",
      "severity": "critical"
    },
    {
      "id": "LBS002",
      "on": "comment",
      "text_matches": "FIXME|TODO",
      "message": "unresolved FIXME/TODO comment",
      "severity": "minor"
    },
    {
      "id": "LBS003",
      "on": "command_substitution",
      "text_matches": "^`",
      "message": "backtick command substitution (use $(...))",
      "severity": "minor"
    },
    {
      "id": "LBS004",
      "query": "(command name: (command_name) @n)",
      "text_matches": "^cd$",
      "message": "cd without guard (use 'cd ... || exit')",
      "severity": "major"
    },
    {
      "id": "LBS005",
      "query": "((command name: (command_name (word) @w)) @cmd (#eq? @w \"chmod\"))",
      "text_matches": "\\b777\\b",
      "message": "world-writable chmod 777",
      "severity": "major"
    },
    {
      "id": "LBS006",
      "query": "(command name: (command_name) @n)",
      "text_matches": "^eval$",
      "message": "eval used",
      "severity": "critical"
    }
  ]
}
