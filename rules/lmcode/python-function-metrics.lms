# Chapter: Rules (lmcode) - Python function metrics
# Shows: @function_definition rules, Node arithmetic (end_row - start_row)
# Run: lmscript rules/lmcode/python-function-metrics.lms   (then: lmbetter --dsl build/rules-lmcode/python-function-metrics.dslb)
# Needs: nothing (offline); reads tests/fixtures/python-logic-violations.py
# exit: 0
# expect:
#|[{"row":0,"col":0,"end_row":62,"end_col":16,"rule":"LBP101","severity":"major","message":"function too long (62 rows)"}]
#|1 findings
p = _lmcode_ cli="lmbetter" install="github:lmctl-ai/lmbetter@latest";

# Tier-1 rule that needs lmcode LOGIC (row arithmetic) — not expressible as
# pack selector+regex. To use against your own file, copy the rule fn and
# point file_read at it (see rules/README.md).

@function_definition
fn function_too_long(n: Node) -> void implements Rule {
  let rows = n.end_row() - n.start_row();
  if (rows > 60) {
    ts.report(n, "function too long (" + str(rows) + " rows)", "LBP101", "major");
  }
}

let tree = ts.parse_python(file_read("tests/fixtures/python-logic-violations.py"));
for (f in ts.query_python(tree.root(), "(function_definition) @f")) {
  function_too_long(f);
}
println(ts.report_json());
println(str(ts.report_count()) + " findings");

end _lmcode_
savedsl(p, "build/rules-lmcode/python-function-metrics.dslb");
