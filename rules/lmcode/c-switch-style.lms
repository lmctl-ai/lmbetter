# Chapter: Rules (lmcode) - C switch/branch style
# Shows: @switch_statement/@if_statement rules, kind checks over children, text prefix check for default
# Run: lmscript rules/lmcode/c-switch-style.lms   (then: lmbetter check --lang c build/rules-lmcode/c-switch-style.dslb tests/fixtures/c-logic-violations.c)
# check: c tests/fixtures/c-logic-violations.c
# Needs: nothing (offline); reads tests/fixtures/c-logic-violations.c
# exit: 0
# expect:
#|[{"row":72,"col":2,"end_row":75,"end_col":3,"rule":"LBC103","severity":"minor","message":"switch without default"},{"row":80,"col":13,"end_row":80,"end_col":17,"rule":"LBC104","severity":"minor","message":"if without braces"}]
#|2 findings
p = _lmcode_ cli="lmbetter";

# default: is a case_statement WITHOUT a value; in lmcode the robust check is
# the text prefix (the keyword is part of the node text).

@switch_statement
fn switch_without_default(n: Node) -> void implements Rule {
  let has_default = 0;
  for (i in range(0, n.child_count())) {
    let body = n.child(i);
    if (body.kind() == "compound_statement") {
      for (j in range(0, body.child_count())) {
        let stmt = body.child(j);
        if (stmt.kind() == "case_statement" && str_starts_with(stmt.text(), "default")) { has_default = 1; }
      }
    }
  }
  if (has_default == 0) {
    ts.report(n, "switch without default", "LBC103", "minor");
  }
}

@if_statement
fn if_without_braces(n: Node) -> void implements Rule {
  # named children: condition (parenthesized_expression), consequence, [else_clause]
  if (n.child_count() > 1 && n.child(1).kind() != "compound_statement") {
    ts.report(n.child(1), "if without braces", "LBC104", "minor");
  }
}

end _lmcode_
savedsl(p, "build/rules-lmcode/c-switch-style.dslb");
