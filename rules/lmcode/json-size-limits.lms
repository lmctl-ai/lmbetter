# Chapter: Rules (lmcode) - JSON object size limits
# Shows: @object rule, counting children by kind
# Run: lmscript rules/lmcode/json-size-limits.lms   (then: lmbetter --dsl build/rules-lmcode/json-size-limits.dslb)
# Needs: nothing (offline); reads tests/fixtures/json-size-violations.json
# exit: 0
# expect:
#|[{"row":0,"col":0,"end_row":52,"end_col":1,"rule":"LBJ102","severity":"minor","message":"object too large (51 entries)"}]
#|1 findings
p = _lmcode_ cli="lmbetter" install="github:lmctl-ai/lmbetter@latest";

@object
fn object_too_large(n: Node) -> void implements Rule {
  let pairs = 0;
  for (i in range(0, n.child_count())) {
    if (n.child(i).kind() == "pair") { pairs = pairs + 1; }
  }
  if (pairs > 50) {
    ts.report(n, "object too large (" + str(pairs) + " entries)", "LBJ102", "minor");
  }
}

let tree = ts.parse(file_read("tests/fixtures/json-size-violations.json"));
for (o in ts.query(tree.root(), "(object) @o")) { object_too_large(o); }
println(ts.report_json());
println(str(ts.report_count()) + " findings");

end _lmcode_
savedsl(p, "build/rules-lmcode/json-size-limits.dslb");
